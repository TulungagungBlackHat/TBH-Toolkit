    ("paramfinder", "modules.paramfinder", "hidden params (active + from js)"),
    ("jsleak", "modules.jsleak", "secrets in js files"),
    ("xss", "modules.xss", "reflected xss, blind mode w/ callback"),
    ("sqli", "modules.sqli", "error-based sqli"),
