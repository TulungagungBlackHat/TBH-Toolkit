#!/usr/bin/env python3
"""tbh - Tulungagung Black Hat toolkit.

everything used to be its own repo, merged it all here in v4.
menu when you run it bare, subcommands when you know what you want.

authorized targets only.
"""
import importlib, json, os, re, subprocess, sys

VERSION = "4.1"
REPO_ROOT = os.path.dirname(os.path.abspath(__file__))
TBH_HOME = os.path.expanduser("~/.tbh")
CONFIG_PATH = os.path.join(TBH_HOME, "config.json")
FINDINGS_PATH = os.path.join(TBH_HOME, "findings.jsonl")

# which tools actually accept which flags (argparse hates surprises)
FULL = {"--proxy", "--cookie", "--timeout", "-H"}
SUPPORT = {
    "proxy": {"recon", "subfinder", "dirfinder", "paramfinder", "jsleak",
              "xss", "sqli", "lfi", "ssrf", "ssti", "redirect", "idor",
              "cors", "web"},
    "cookie": {"recon", "dirfinder", "paramfinder", "jsleak",
               "xss", "sqli", "lfi", "ssrf", "ssti", "redirect", "idor",
               "cors", "web"},
    "timeout": {"recon", "subfinder", "dirfinder", "paramfinder", "jsleak",
                "xss", "sqli", "lfi", "ssrf", "ssti", "redirect", "idor",
                "cors", "web", "portscan"},
    "header": {"recon", "dirfinder", "paramfinder", "jsleak",
               "xss", "sqli", "lfi", "ssrf", "ssti", "redirect", "idor",
               "cors", "web"},
}

def load_config():
    try:
        with open(CONFIG_PATH) as f:
            cfg = json.load(f)
        return cfg if isinstance(cfg, dict) else {}
    except (OSError, ValueError):
        return {}

def save_config(cfg):
    os.makedirs(TBH_HOME, exist_ok=True)
    with open(CONFIG_PATH, "w") as f:
        json.dump(cfg, f, indent=2)

def finalize_argv(name, args):
    """append proxy/cookie/timeout/header from ~/.tbh/config.json
    unless the user already passed that flag."""
    cfg = load_config()
    out = list(args)
    if cfg.get("proxy") and name in SUPPORT["proxy"] and "--proxy" not in out:
        out += ["--proxy", str(cfg["proxy"])]
    if cfg.get("cookie") and name in SUPPORT["cookie"] and "--cookie" not in out:
        out += ["--cookie", str(cfg["cookie"])]
    if cfg.get("timeout") and name in SUPPORT["timeout"] and "--timeout" not in out:
        out += ["--timeout", str(cfg["timeout"])]
    headers = cfg.get("header") or []
    if headers and name in SUPPORT["header"] and "-H" not in out:
        for h in headers:
            out += ["-H", str(h)]
    return out

