def color(code, text):
    if os.environ.get("NO_COLOR") or not sys.stdout.isatty():
        return text
    return f"\033[{code}m{text}\033[0m"

def cmd_map():
    return {name: mod for name, mod, _ in REGISTRY}

def print_help():
    print(color("91", "TBH") + f" v{VERSION} - tulungagung black hat toolkit")
    print("usage: tbh            # menu\n      tbh <tool> [flags]\n")
    print(color("96", "tools:"))
    width = max(len(n) for n, _, _ in REGISTRY)
    for name, mod, desc in REGISTRY:
        try:
            src = open(os.path.join(REPO_ROOT, mod.replace(".", "/") + ".py")).read()
            ver = re.search(r'VERSION = "([^"]+)"', src)
            v = f" v{ver.group(1)}" if ver else ""
        except OSError:
            v = ""
        print(f"  {name:<{width}}  {desc}{color('90', v)}")
    print(color("96", "\nother:"))
    print("  tbh list           tool versions")
    print("  tbh doctor         check python/requests")
    print("  tbh update         git pull")
    print("  tbh ui            terminal UI (curses, for termux)")
    print("  tbh config         show saved proxy/cookie/timeout/headers")
    print("  tbh findings       what scan has saved so far")
    print(color("96", "\nexamples:"))
    print("  tbh config set proxy http://127.0.0.1:8080   # then every tool uses it")
    print("  tbh scan -u https://example.com --deep --html out.html")
    print("  tbh recon -u https://example.com --ssl -p")
    print("  tbh xss -u 'https://example.com/?q=test' --param all")
    print("  tbh <tool> --help for that tool's flags")
    print(color("91", "\nauthorized targets only."))

def cmd_list():
    print(f"{'TOOL':14} {'VERSION':8} DESCRIPTION")
    for name, mod, desc in REGISTRY:
        try:
            src = open(os.path.join(REPO_ROOT, mod.replace(".", "/") + ".py")).read()
            ver = re.search(r'VERSION = "([^"]+)"', src).group(1)
        except (OSError, AttributeError):
            ver = "?"
        print(f"{name:14} {ver:8} {desc}")
    return 0

def cmd_doctor():
    ok = True
    def check(label, good, detail=""):
        nonlocal ok
        mark = color("92", "[OK]") if good else color("91", "[!!]")
        if not good:
            ok = False
        print(f"{mark} {label}" + (f" - {detail}" if detail else ""))
    py = sys.version_info
    check(f"Python {py.major}.{py.minor}.{py.micro}", py >= (3, 8))
    try:
        import requests
        check(f"requests {requests.__version__}", True)
    except ImportError:
        check("requests", False, "pip install requests")
    n_mod = len([f for f in os.listdir(os.path.join(REPO_ROOT, "modules")) if f.endswith(".py")])
    check(f"modules: {n_mod - 1} tool files", n_mod - 1 >= len(REGISTRY) - 1)
    check("git repo", os.path.isdir(os.path.join(REPO_ROOT, ".git")))
    print("All good." if ok else "Problems found.")
    return 0 if ok else 1

def cmd_update():
    if not os.path.isdir(os.path.join(REPO_ROOT, ".git")):
        print(color("91", "[!] not a git checkout; reinstall via install.sh"), file=sys.stderr)
        return 2
    print("[*] git pull --ff-only ...")
    r = subprocess.call(["git", "pull", "--ff-only"], cwd=REPO_ROOT)
    if r == 0:
        print(color("92", "[✓] updated"))
    return r

CONFIG_KEYS = ("proxy", "cookie", "timeout", "header")

def cmd_config(argv):
    cfg = load_config()
    if not argv:
        print(f"config: {CONFIG_PATH}")
        if not cfg:
            print("  (empty - set something with: tbh config set proxy http://127.0.0.1:8080)")
        for k in CONFIG_KEYS:
            v = cfg.get(k)
            if v:
                print(f"  {k} = {v}")
        return 0
    sub = argv[0]
    if sub == "path":
        print(CONFIG_PATH)
        return 0
    if sub == "set" and len(argv) >= 3:
        key, val = argv[1], " ".join(argv[2:])
        if key not in CONFIG_KEYS:
            print(color("91", f"[!] unknown key '{key}' (one of: {', '.join(CONFIG_KEYS)})"), file=sys.stderr)
            return 2
        if key == "timeout":
            try:
                val = int(val)
            except ValueError:
                print(color("91", "[!] timeout must be a number"), file=sys.stderr)
                return 2
        if key == "header":
            cfg.setdefault("header", [])
            if val not in cfg["header"]:
                cfg["header"].append(val)
        else:
            cfg[key] = val
        save_config(cfg)
        print(color("92", f"[+] {key} saved"))
        return 0
    if sub == "unset" and len(argv) >= 2:
        key = argv[1]
        if key == "header" and len(argv) >= 3:
            h = " ".join(argv[2:])
            cfg["header"] = [x for x in cfg.get("header", []) if x != h]
        elif key in CONFIG_KEYS:
            cfg.pop(key, None)
        else:
            print(color("91", f"[!] unknown key '{key}'"), file=sys.stderr)
            return 2
        save_config(cfg)
        print(color("92", f"[+] {key} cleared"))
        return 0
    print("usage: tbh config [set <key> <value> | unset <key> | path]", file=sys.stderr)
    return 2

def cmd_findings():
    if not os.path.isfile(FINDINGS_PATH):
        print("no findings saved yet (run: tbh scan -u <url>)")
        return 0
    with open(FINDINGS_PATH) as f:
        lines = f.readlines()
    print(f"{len(lines)} finding(s) in {FINDINGS_PATH}")
    for line in lines[-20:]:
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        sev = rec.get("severity", "info")
        print(f"  {rec.get('when','?')}  [{sev}]  {rec.get('tool','?'):<10} "
              f"{rec.get('url', rec.get('target', ''))}")
    if len(lines) > 20:
        print(f"  ... {len(lines) - 20} older, see the file")
    return 0

def input_line(prompt):
    try:
        return input(prompt)
    except EOFError:
        return None

def run_tool(name, extra, target=None):
    target_flag = "-t" if name in ("portscan", "subfinder") else "-u"
    cmdline = [sys.executable, os.path.abspath(__file__), name]
    if target:
        cmdline += [target_flag, target]
    cmdline += finalize_argv(name, extra)
    print(color("96", f"[*] running: {' '.join(cmdline[2:])}"), flush=True)
    return subprocess.call(cmdline)

def interactive():
    """Numbered menu (Termux classic style)."""
    import shlex
    tools = REGISTRY
    cfg = load_config()
    last_target = ""
    try:
        with open(os.path.join(TBH_HOME, "last_target")) as f:
            last_target = f.read().strip()
    except OSError:
        pass
    session_target = last_target
    while True:
        print()
        print(color("91", "╔════════════════════════════════════╗"))
        print(color("91", "║") + color("0", "   TBH Toolkit v" + VERSION + "  -  Menu     ") + color("91", "║"))
        print(color("91", "║") + color("90", "   Tulungagung Black Hat             ") + color("91", "║"))
        print(color("91", "╚════════════════════════════════════╝"))
        extras = []
        if cfg.get("proxy"):
            extras.append(f"proxy={cfg['proxy']}")
        if cfg.get("cookie"):
            extras.append("cookie=set")
        if cfg.get("header"):
            extras.append(f"headers={len(cfg['header'])}")
        if extras:
            print(color("90", "  config: " + ", ".join(extras) + "  (tbh config to change)"))
        width = max(len(n) for n, _, _ in tools)
        for i, (name, _, desc) in enumerate(tools, 1):
            print(f"  {color('96', f'[{i:>2}]')} {name:<{width}}  {desc}")
        print(f"  {color('96', '[ W]')} ui        terminal UI (curses)")
        print(f"  {color('96', '[ C]')} config    proxy/cookie/timeout/headers")
        print(f"  {color('96', '[ F]')} findings  what scan has saved")
        print(f"  {color('96', '[ D]')} doctor    environment check")
        print(f"  {color('96', '[ U]')} update    git pull this toolkit")
        print(f"  {color('96', '[ 0]')} exit")
        print(color("90", "─" * 40))
        raw = input_line(color("91", "tbh> "))
        if raw is None:
            print()
            return 0
        choice = raw.strip().lower()
        if choice in ("0", "q", "exit", "quit"):
            print(color("90", "bye. authorized targets only."))
            return 0
        if choice in ("w", "ui"):
            subprocess.call([sys.executable, os.path.abspath(__file__), "ui"])
            input_line(color("90", "[enter] to return to menu"))
            continue
        if choice in ("c", "config"):
            cmd_config([])
            input_line(color("90", "[enter]"))
            continue
        if choice in ("f", "findings"):
            cmd_findings()
            input_line(color("90", "[enter]"))
            continue
        if choice in ("d", "doctor"):
            cmd_doctor()
            input_line(color("90", "[enter]"))
            continue
        if choice in ("u", "update"):
            cmd_update()
            input_line(color("90", "[enter]"))
            continue
        if choice in ("v", "version", "--version"):
            print(f"TBH {VERSION}")
            input_line(color("90", "[enter]"))
            continue
        if choice in ("h", "help", "?"):
            print_help()
            input_line(color("90", "[enter]"))
            continue
        # accept a tool name too, not just its number
        name = None
        if choice.isdigit() and 1 <= int(choice) <= len(tools):
            name = tools[int(choice) - 1][0]
        elif choice in ALIASES:
            name = ALIASES[choice]
        else:
            for cand, _mod, _d in tools:
                if choice == cand:
                    name = cand
                    break
        if name is None:
            print(color("91", f"[!] invalid choice '{choice}'"))
            continue
        desc = next(d for n, _, d in tools if n == name)
        print(color("96", f"[*] {name} - {desc}"))
        target = None
        if name not in ("utils", "passstrength"):
            hint = f" [{session_target}]" if session_target else ""
            t = input_line(f"    target URL{hint} (enter = reuse, blank = tool menu/help): ")
            if t is None:
                return 0
            t = t.strip()
            if t:
                target = t
                session_target = t
                try:
                    os.makedirs(TBH_HOME, exist_ok=True)
                    with open(os.path.join(TBH_HOME, "last_target"), "w") as f:
                        f.write(t)
                except OSError:
                    pass
            elif session_target:
                target = session_target
        extra_raw = input_line("    extra flags (optional, e.g. --param all --json r.json): ")
        if extra_raw is None:
            return 0
        try:
            extra = shlex.split(extra_raw.strip()) if extra_raw.strip() else []
        except ValueError as e:
            print(color("91", f"[!] bad flags: {e}"))
            continue
        run_tool(name, extra, target)
        input_line(color("90", "[enter] to return to menu"))

def main():
    if len(sys.argv) == 1:
        if sys.stdin.isatty() or os.environ.get("TBH_FORCE_MENU"):
            return interactive()
        print_help()
        return 0
    arg = sys.argv[1]
    if arg in ("-h", "--help", "help"):
        print_help()
        return 0
    if arg in ("-V", "--version", "version"):
        print(f"TBH {VERSION}")
        return 0
    if arg == "list":
        return cmd_list()
    if arg == "doctor":
        return cmd_doctor()
    if arg == "update":
        return cmd_update()
    if arg == "config":
        return cmd_config(sys.argv[2:])
    if arg == "findings":
        return cmd_findings()
    if arg == "ui":
        try:
            from modules import ui
        except ImportError as e:
            print(color("91", f"[!] ui needs a working terminal: {e}"), file=sys.stderr)
            return 2
        sys.argv = ["tbh ui"] + sys.argv[2:]
        return ui.main()
    name = ALIASES.get(arg, arg)
    modules = cmd_map()
    if name not in modules:
        print(color("91", f"[!] unknown tool '{arg}' (tbh --help for the list)"), file=sys.stderr)
        return 2
    try:
        mod = importlib.import_module(modules[name])
    except ImportError as e:
        print(color("91", f"[!] cannot load {name}: {e}"), file=sys.stderr)
        print(color("91", "[!] pip install requests"), file=sys.stderr)
        return 2
    sys.argv = [f"tbh {name}"] + finalize_argv(name, sys.argv[2:])
    return mod.main() or 0

if __name__ == "__main__":
    sys.exit(main())
