#!/usr/bin/env python3
"""TBH v4 - Tulungagung Black Hat unified security toolkit (authorized testing only).

One command, all tools:  tbh <tool> [flags]
"""
import importlib, os, re, subprocess, sys

VERSION = "4.0"
REPO_ROOT = os.path.dirname(os.path.abspath(__file__))

REGISTRY = [
    ("recon", "modules.recon", "Web recon: headers, SSL, ports, subdomains"),
    ("subfinder", "modules.subfinder", "Subdomain enum + CNAME takeover detection"),
    ("dirfinder", "modules.dirfinder", "Directory discovery with recursion (--depth)"),
    ("paramfinder", "modules.paramfinder", "Hidden parameter discovery (active + passive)"),
    ("jsleak", "modules.jsleak", "Secrets hunting in JavaScript files"),
    ("xss", "modules.xss", "Reflected XSS detector (multi-payload, blind callback)"),
    ("sqli", "modules.sqli", "Error-based SQL injection detector"),
    ("lfi", "modules.lfi", "Path traversal / LFI detector"),
    ("ssrf", "modules.ssrf", "SSRF detector (URL params, OOB collab)"),
    ("ssti", "modules.ssti", "Template injection detector (dual-math)"),
    ("redirect", "modules.redirect", "Open redirect detector"),
    ("idor", "modules.idor", "IDOR probe (ID swap window)"),
    ("cors", "modules.cors", "CORS misconfiguration detector"),
    ("portscan", "modules.portscan", "Port scanner: top-100, banners, CVE hints"),
    ("phish", "modules.phish", "Phishing URL detector (12 heuristics)"),
    ("passstrength", "modules.passstrength", "Password strength checker + generator"),
    ("utils", "modules.utils", "Encoder utilities: b64, url, hash, jwt inspect"),
    ("web", "modules.cli", "34-module web check suite (was TBH-CLI)"),
]
ALIASES = {"cli": "web", "scanner": "portscan", "password": "passstrength"}
META = ("list", "doctor", "update", "version", "help")

def color(code, text):
    if os.environ.get("NO_COLOR") or not sys.stdout.isatty():
        return text
    return f"\033[{code}m{text}\033[0m"

def cmd_map():
    return {name: mod for name, mod, _ in REGISTRY}

def print_help():
    print(color("91", "TBH") + f" v{VERSION} - Tulungagung Black Hat unified toolkit")
    print("Usage: tbh <tool> [flags]\n")
    print(color("96", "Tools:"))
    width = max(len(n) for n, _, _ in REGISTRY)
    for name, mod, desc in REGISTRY:
        try:
            src = open(os.path.join(REPO_ROOT, mod.replace(".", "/") + ".py")).read()
            ver = re.search(r'VERSION = "([^"]+)"', src)
            v = f" v{ver.group(1)}" if ver else ""
        except OSError:
            v = ""
        print(f"  {name:<{width}}  {desc}{color('90', v)}")
    print(color("96", "\nMeta:"))
    print("  list               same as tools with versions")
    print("  doctor             check python/requests environment")
    print("  update             git pull this toolkit")
    print("  version            print toolkit version")
    print(color("96", "\nExamples:"))
    print("  tbh recon -u https://example.com --ssl -p -s")
    print("  tbh xss -u 'https://example.com/?q=test' --param all")
    print("  tbh web -u https://example.com --json r.json --html r.html")
    print("  tbh dirfinder -u https://example.com --depth 2")
    print("  tbh --help | tbh <tool> --help for per-tool flags")
    print(color("91", "\n[!] Authorized targets only."))

def cmd_list():
    print(f"{'TOOL':14} {'VERSION':8} DESCRIPTION")
    for name, mod, desc in REGISTRY:
        try:
            src = open(os.path.join(REPO_ROOT, mod.replace(".", "/") + ".py")).read()
            ver = re.search(r'VERSION = "([^"]+)"', src).group(1)
        except (OSError, AttributeError):
            ver = "?"
        print(f"{name:14} {ver:8} {desc}")
    return 0

def cmd_doctor():
    ok = True
    def check(label, good, detail=""):
        nonlocal ok
        mark = color("92", "[OK]") if good else color("91", "[!!]")
        if not good:
            ok = False
        print(f"{mark} {label}" + (f" - {detail}" if detail else ""))
    py = sys.version_info
    check(f"Python {py.major}.{py.minor}.{py.micro}", py >= (3, 8))
    try:
        import requests
        check(f"requests {requests.__version__}", True)
    except ImportError:
        check("requests", False, "pip install requests")
    n_mod = len([f for f in os.listdir(os.path.join(REPO_ROOT, "modules")) if f.endswith(".py")])
    check(f"modules: {n_mod - 1} tool files", n_mod - 1 >= len(REGISTRY) - 1)
    check("git repo", os.path.isdir(os.path.join(REPO_ROOT, ".git")))
    print("All good." if ok else "Problems found.")
    return 0 if ok else 1

def cmd_update():
    if not os.path.isdir(os.path.join(REPO_ROOT, ".git")):
        print(color("91", "[!] not a git checkout; reinstall via install.sh"), file=sys.stderr)
        return 2
    print("[*] git pull --ff-only ...")
    r = subprocess.call(["git", "pull", "--ff-only"], cwd=REPO_ROOT)
    if r == 0:
        print(color("92", "[✓] updated"))
    return r

def input_line(prompt):
    try:
        return input(prompt)
    except EOFError:
        return None

def run_tool(name, extra, target=None):
    cmdline = [sys.executable, os.path.abspath(__file__), name]
    if target:
        cmdline += ["-u", target]
    cmdline += extra
    print(color("96", f"[*] running: {' '.join(cmdline[2:])}"), flush=True)
    return subprocess.call(cmdline)

def interactive():
    """Numbered menu (Termux classic style)."""
    import shlex
    tools = REGISTRY
    while True:
        print()
        print(color("91", "╔════════════════════════════════════╗"))
        print(color("91", "║") + color("0", "   TBH Toolkit v" + VERSION + "  -  Menu     ") + color("91", "║"))
        print(color("91", "║") + color("90", "   Tulungagung Black Hat             ") + color("91", "║"))
        print(color("91", "╚════════════════════════════════════╝"))
        width = max(len(n) for n, _, _ in tools)
        for i, (name, _, desc) in enumerate(tools, 1):
            print(f"  {color('96', f'[{i:>2}]')} {name:<{width}}  {desc}")
        print(f"  {color('96', '[ D]')} doctor    environment check")
        print(f"  {color('96', '[ U]')} update    git pull this toolkit")
        print(f"  {color('96', '[ V]')} version   print version")
        print(f"  {color('96', '[ 0]')} exit")
        print(color("90", "─" * 40))
        raw = input_line(color("91", "tbh> "))
        if raw is None:
            print()
            return 0
        choice = raw.strip().lower()
        if choice in ("0", "q", "exit", "quit"):
            print(color("90", "bye. authorized targets only."))
            return 0
        if choice in ("d", "doctor"):
            cmd_doctor()
            input_line(color("90", "[enter]"))
            continue
        if choice in ("u", "update"):
            cmd_update()
            input_line(color("90", "[enter]"))
            continue
        if choice in ("v", "version", "--version"):
            print(f"TBH {VERSION}")
            input_line(color("90", "[enter]"))
            continue
        if choice in ("h", "help", "?"):
            print_help()
            input_line(color("90", "[enter]"))
            continue
        if not choice.isdigit() or not (1 <= int(choice) <= len(tools)):
            print(color("91", f"[!] invalid choice '{choice}'"))
            continue
        name, _, desc = tools[int(choice) - 1]
        print(color("96", f"[*] {name} - {desc}"))
        target = None
        if name not in ("utils", "passstrength"):
            t = input_line("    target URL (blank = tool's own menu/help): ")
            if t is None:
                return 0
            t = t.strip()
            if t:
                target = t
        extra_raw = input_line("    extra flags (optional, e.g. --param all --json r.json): ")
        if extra_raw is None:
            return 0
        try:
            extra = shlex.split(extra_raw.strip()) if extra_raw.strip() else []
        except ValueError as e:
            print(color("91", f"[!] bad flags: {e}"))
            continue
        run_tool(name, extra, target)
        input_line(color("90", "[enter] to return to menu"))

def main():
    if len(sys.argv) == 1:
        if sys.stdin.isatty() or os.environ.get("TBH_FORCE_MENU"):
            return interactive()
        print_help()
        return 0
    arg = sys.argv[1]
    if arg in ("-h", "--help", "help"):
        print_help()
        return 0
    if arg in ("-V", "--version", "version"):
        print(f"TBH {VERSION}")
        return 0
    if arg == "list":
        return cmd_list()
    if arg == "doctor":
        return cmd_doctor()
    if arg == "update":
        return cmd_update()
    name = ALIASES.get(arg, arg)
    modules = cmd_map()
    if name not in modules:
        print(color("91", f"[!] unknown tool '{arg}' (tbh --help for the list)"), file=sys.stderr)
        return 2
    try:
        mod = importlib.import_module(modules[name])
    except ImportError as e:
        print(color("91", f"[!] cannot load {name}: {e}"), file=sys.stderr)
        print(color("91", "[!] pip install requests"), file=sys.stderr)
        return 2
    sys.argv = [f"tbh {name}"] + sys.argv[2:]
    return mod.main() or 0

if __name__ == "__main__":
    sys.exit(main())
